#!/usr/bin/env python3

import json
import os
import subprocess
import sys


def parse_args(args: list[str]) -> tuple[str, int | None]:
    # The old E of the user's LazyGit configs still passes --tab.
    if args[:1] == ["--tab"]:
        args = args[1:]

    if not args:
        raise SystemExit(1)

    line: int | None = None

    if len(args) > 1 and args[0].isdigit():
        line = int(args[0])
        args = args[1:]

    if len(args) > 1 and args[-1].isdigit():
        line = int(args[-1])
        args = args[:-1]

    path = " ".join(args).strip()
    if not path:
        raise SystemExit(1)

    if not os.path.isabs(path):
        path = os.path.abspath(path)

    return path, line


def remote_expr(server: str, expr: str, *, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["nvim", "--server", server, "--remote-expr", expr],
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
    )


def main() -> int:
    # Lazygit's custom e/E: key=value pairs (commit, new_tab, folder)
    # for the edit that follows. Nothing to do without a parent Neovim.
    if sys.argv[1:2] == ["--expect"]:
        if not os.environ.get("NVIM"):
            return 0
        pairs = dict(arg.split("=", 1) for arg in sys.argv[2:])
        lua = "require('features.lazygit_edit').expect(_A)"
        return remote_expr(os.environ["NVIM"], f"luaeval({json.dumps(lua)}, {json.dumps(pairs)})").returncode

    path, line = parse_args(sys.argv[1:])

    if not os.environ.get("NVIM"):
        cmd = ["nvim"]
        if line is not None:
            cmd.append(f"+{line}")
        cmd.extend(["--", path])
        os.execvp(cmd[0], cmd)

    server = os.environ["NVIM"]
    lua = "require('features.lazygit_edit').edit(_A[1], _A[2])"
    arg2 = "v:null" if line is None else str(line)
    expr = f"luaeval({json.dumps(lua)}, [{json.dumps(path)}, {arg2}])"

    result = remote_expr(server, expr)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
